# Normalize to LF in the repository and in the working tree: the PHP runs on
# Linux inside the container, whatever the host is.
* text=auto eol=lf

*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.txt text eol=lf
*.pot text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
