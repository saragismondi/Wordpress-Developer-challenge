# Local-only credentials for the AgroNews challenge environment.
# Copy to .env (bin/setup.sh does it for you) and adjust if a port clashes.

# Host port the site is published on: http://localhost:${WP_PORT}
WP_PORT=8088

# Site identity
WP_URL=http://localhost:8088
WP_TITLE=AgroNews
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@agronews.example

# Database
DB_NAME=agronews
DB_USER=agronews
DB_PASSWORD=agronews
DB_ROOT_PASSWORD=root
DB_PREFIX=wp_
# Database used by the PHPUnit suite (created by docker/db/initdb.d).
DB_TEST_NAME=agronews_test

# WP_DEBUG for the web container (0/1)
WP_DEBUG=0

# Enables the an-bench mu-plugin (SAVEQUERIES + X-AN-* headers).
# Local only: these headers expose internals. Changing it needs a container
# recreate: docker compose up -d
AN_BENCH=1
